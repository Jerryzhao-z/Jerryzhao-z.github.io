---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props { title?: string; description?: string; canonicalPath?: string; }
const {
  title = 'Jerry',
  description = 'Jerry 的个人记录：好奇、学习、观察，以及还没有想明白的问题。',
  canonicalPath,
} = Astro.props;
const pageTitle = title === 'Jerry' ? title : `${title} · Jerry`;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} /><meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} /><link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body><a class="skip-link" href="#main-content">跳到正文</a><Header /><main id="main-content"><slot /></main><Footer /></body>
</html>
