---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" description="这个地址没有对应的页面。">
  <section class="page-heading shell error-page">
    <p class="eyebrow">404</p>
    <h1>这里没有内容。</h1>
    <p>地址可能已经变化，或文章尚未发布。</p>
    <a class="button" href="/">返回首页</a>
  </section>
</BaseLayout>
