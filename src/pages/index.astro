---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 5);
---
<BaseLayout>
  <section class="profile-intro shell">
    <p class="profile-kicker">Jerry 的个人记录</p>
    <h1>从好奇开始，慢慢理解。</h1>
    <p class="profile-copy">这里记下一些让我好奇的事。最近常常是 AI，也包括阅读、观察，以及还没有想明白的问题。机器学习、深度学习、数学和工程，是顺着这些问题继续学习时经过的路径。</p>
    <p class="profile-links"><a href="/about/">更多关于我</a><span aria-hidden="true">·</span><a href="/blog/">查看文章</a></p>
  </section>
  <div class="home-grid shell">
    <section class="section"><div class="section-heading"><h2>最近记录</h2><a class="text-link" href="/blog/">全部记录 →</a></div>{recentPosts.length > 0 ? <div class="post-list">{recentPosts.map((post) => <PostCard post={post} />)}</div> : <p class="quiet-empty">第一篇记录正在整理中。</p>}</section>
  </div>
</BaseLayout>
